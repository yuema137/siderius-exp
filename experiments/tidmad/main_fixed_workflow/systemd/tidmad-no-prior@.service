[Unit]
Description=SIDERIUS TIDMAD NoPrior fixed workflow for %i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=@UNIT_MOUNT@
ConditionPathIsMountPoint=@UNIT_MOUNT@

[Service]
Type=simple
User=@NO_PRIOR_USER@
Group=@NO_PRIOR_GROUP@
EnvironmentFile=/etc/tidmad-no-prior/%i.env
ExecStart=/usr/bin/env /bin/bash ${EXP_CHECKOUT}/experiments/tidmad/main_fixed_workflow/launch.sh --launch --siderius-checkout ${SIDERIUS_CHECKOUT} --band ${BAND} --data_dir ${DATA_DIR} --unit-dir ${UNIT_DIR} --run_name ${RUN_NAME}
Restart=on-failure
RestartPreventExitStatus=2 3
RestartSec=10s
KillMode=control-group
UMask=0077

[Install]
WantedBy=multi-user.target
