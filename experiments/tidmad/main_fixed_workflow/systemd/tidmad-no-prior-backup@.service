[Unit]
Description=Back up retained SIDERIUS NoPrior artifacts for %i
After=network-online.target
Wants=network-online.target
RequiresMountsFor=@UNIT_MOUNT@
ConditionPathIsMountPoint=@UNIT_MOUNT@
ConditionPathExists=@UNIT_MOUNT@/%i-unit/launch.json

[Service]
Type=oneshot
TimeoutStartSec=1h
EnvironmentFile=/etc/tidmad-no-prior/%i.env
EnvironmentFile=/etc/tidmad-no-prior/%i-backup.env
Environment=PATH=/opt/tidmad-no-prior/awscli-venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin
ExecStart=/usr/bin/env /bin/bash ${EXP_CHECKOUT}/experiments/tidmad/main_fixed_workflow/backup.sh --unit-dir ${UNIT_DIR} --bucket ${BACKUP_BUCKET} --prefix ${BACKUP_PREFIX} --endpoint ${BACKUP_ENDPOINT} --instance %i
UMask=0077
